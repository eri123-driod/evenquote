# Copia este archivo como .env y pon tus datos reales.
# Si tu usuario root de MySQL no tiene contraseña (XAMPP): mysql+pymysql://root:@localhost:3306/eventquote_db
DATABASE_URL=mysql+pymysql://root:TU_CONTRASENA@localhost:3306/eventquote_db
# Cadena larga y aleatoria (mínimo 16 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_esto_por_una_cadena_larga_y_aleatoria
